APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# 프론트는 기본적으로 상대 경로 "/api"를 쓰고, vite dev server의 프록시가 백엔드로 넘긴다
# (vite.config.ts의 server.proxy 참고). 외부 IP로 접속해도 그대로 동작하므로 보통 비워둔다.
# 백엔드를 다른 호스트/포트에 띄운 경우에만 절대 URL을 지정한다.
# 이 값은 vite가 frontend/ 기준으로 읽으므로 frontend/.env 에 둬야 한다.
# VITE_API_BASE_URL=http://<host>:8000/api

# Add provider credentials locally when the LLM integration starts.
# Never commit real secrets.
LLM_API_KEY=
LLM_MODEL=

